# 复制这个文件为 .env，然后把 key 填进去（.env 不要提交到 git、不要发群里）
# 复制命令（在 01_single_agent 目录下）：cp .env.example .env

# 你的 API Key
LLM_API_KEY=

# 接口地址（结尾不要带 /）
# 本地调试用 DeepSeek：https://api.deepseek.com/v1
# 用华为云 MaaS 时，去 MaaS 控制台 -> 在线推理 -> 调用说明，复制那里的 base_url 填在这里
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（要和平台上开通的一致）
# DeepSeek 用 deepseek-chat；华为云 MaaS 填你在"在线推理"里看到的模型名
LLM_MODEL=deepseek-chat

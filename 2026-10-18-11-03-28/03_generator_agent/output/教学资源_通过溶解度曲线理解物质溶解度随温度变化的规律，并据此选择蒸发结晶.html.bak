<!doctype html>
<html lang="zh-CN" class="pf-hosted">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="logo.png">
  <title>师伴-溶解度曲线理解物质溶解度</title>

  <!-- 平台统一外壳（与老师下发的 template 保持一致，不要改） -->
  <link rel="stylesheet" href="frame.css">
  <!-- 六区域内容样式 -->
  <link rel="stylesheet" href="exp.css">
  <style>

  </style>
  <!-- 平台阅读规范：正文纯黑 / 最小字号 26px / 名称只在页眉 -->
  <style>
/* =====================================================================
 *  normal.css —— 平台阅读规范（后置强制层）
 *
 *  它排在加载顺序的最后：
 *      frame.css → exp.css → 页面自带样式(EXTRA_CSS) → 本文件
 *  所以这里的规则会盖住前面所有定义，包括模型自己写进页面的 CSS。
 *  作用只有一个：让 30 个页面读起来像同一个东西，而不是每页一个风格。
 *
 *  三条规范：
 *    1. 正文文字一律纯黑 #000（不再跟随蓝色主题色）
 *    2. 最小字号 26px（= 原始 13px × 2；配合 typo.js 兜住页面自带的 9~12px 小字）
 *    3. 实验名称只在页眉出现一次，① 区不再重复
 * ===================================================================== */

:root {
  --pf-fs-min: 26px;      /* 全站最小字号（= 原始 13px × 2），改这里就够 */
  --pf-body-ink: #000;    /* 正文文字色 */
}

/* ---------------------------------------------------------------------
 * 1. 正文纯黑
 *    只作用于「承载正文的元素」，不碰按钮、胶囊标签、读数数值、警示块
 *    这些有语义的强调色，否则页面会失去层次。
 * ------------------------------------------------------------------- */
.pf-hosted .exp-wrap .exp-goals,
.pf-hosted .exp-wrap .exp-goals li,
.pf-hosted .exp-wrap .exp-goals-title,
.pf-hosted .exp-wrap .exp-card > h2,
.pf-hosted .exp-wrap .exp-teach summary,
.pf-hosted .exp-wrap .exp-teach h3,
.pf-hosted .exp-wrap .exp-body,
.pf-hosted .exp-wrap .exp-body p,
.pf-hosted .exp-wrap .exp-body li,
.pf-hosted .exp-wrap p,
.pf-hosted .exp-wrap li,
.pf-hosted .exp-wrap td,
.pf-hosted .exp-wrap th,
.pf-hosted .exp-wrap dt,
.pf-hosted .exp-wrap dd,
.pf-hosted .exp-wrap .exp-note,
.pf-hosted .exp-wrap .exp-label,
.pf-hosted .exp-wrap .exp-field,
.pf-hosted .exp-wrap .exp-formula,
.pf-hosted .exp-wrap .exp-table,
.pf-hosted .exp-wrap .exp-hint,
.pf-hosted .exp-wrap .exp-canvas-tip {
  color: var(--pf-body-ink) !important;
}

/* 段落里用来解释的斜体/引用也统一黑，不保留灰蓝 */
.pf-hosted .exp-wrap .exp-body em,
.pf-hosted .exp-wrap .exp-body i,
.pf-hosted .exp-wrap .exp-body span,
.pf-hosted .exp-wrap .exp-goals span {
  color: var(--pf-body-ink) !important;
}

/* 代入式里的高亮结论（<em>）保留橙色，是「看这里」而不是正文 */
.pf-hosted .exp-wrap .exp-formula em {
  color: #b5561b !important;
  font-weight: 800;
}

/* 警示块保留橙红语义色，但压深到接近黑，保证对比度 */
.pf-hosted .exp-wrap .exp-alert {
  color: #7c2d12 !important;
}

/* ---------------------------------------------------------------------
 * 2. 最小字号：把 exp.css / frame.css 里已知偏小的档位统一抬到 26px+
 *    （页面自己写死的更小字号由 typo.js 在运行时兜底）
 * ------------------------------------------------------------------- */
.pf-hosted .exp-wrap .exp-tag,
.pf-hosted .exp-wrap .exp-hint,
.pf-hosted .exp-wrap .exp-canvas-tip,
.pf-hosted .exp-wrap .exp-read .k,
.pf-hosted .exp-wrap .exp-read .u,
.pf-hosted .exp-wrap .exp-goals-title,
.pf-hosted .exp-wrap .exp-val,
.pf-hosted .exp-wrap .exp-btn,
.pf-hosted .exp-wrap select,
.pf-hosted .exp-wrap input,
.pf-hosted .pf-footer,
.pf-hosted .pf-tip {
  font-size: var(--pf-fs-min);
}

/* 中等档：说明类、代入式、表格、警示，比最小档再大 0.5px */
.pf-hosted .exp-wrap .exp-formula,
.pf-hosted .exp-wrap .exp-note,
.pf-hosted .exp-wrap .exp-alert,
.pf-hosted .exp-wrap .exp-table {
  font-size: 27px;
}

/* 正文（学习目标 / 教学说明）用 28px，比辅助文字再大一档 */
.pf-hosted .exp-wrap .exp-goals,
.pf-hosted .exp-wrap .exp-goals li,
.pf-hosted .exp-wrap .exp-body,
.pf-hosted .exp-wrap .exp-body p,
.pf-hosted .exp-wrap .exp-body li {
  font-size: 28px;
}

/* 标题档：六区域标题 / 教学说明折叠头 */
.pf-hosted .exp-wrap .exp-card > h2,
.pf-hosted .exp-wrap .exp-teach summary {
  font-size: 29px;
}

/* 读数数值：全站最大的字，读数一眼能看清 */
.pf-hosted .exp-wrap .exp-read .v {
  font-size: 38px;
}

/* ---------------------------------------------------------------------
 * 2a-2. 演示区只留实物与图形
 *      画布左下角那条「按住拖动可旋转视角…」是文字块，规范要求删掉。
 *      页面若还生成 .exp-canvas-tip，这里统一隐藏，不用逐页改 HTML。
 * ------------------------------------------------------------------- */
.pf-hosted .exp-wrap .exp-canvas-tip {
  display: none !important;
}

/* ---------------------------------------------------------------------
 * 2b. 字号放大后的版式补偿
 *     字大一倍，原来的格子宽度就不够了：读数卡按两列铺、允许换行，
 *     表格窄了横向滚动。这几条只为「不挤、不裁」，不改字号。
 * ------------------------------------------------------------------- */
.pf-hosted .exp-wrap .exp-reads { gap: 12px; }

.pf-hosted .exp-wrap .exp-read {
  box-sizing: border-box;   /* 不加这句，百分比基准只算内容区，加上内边距就放不下 */
  flex: 1 1 calc(50% - 7px);   /* 默认两列：窄屏、单列时也不会把字挤到折行 */
  min-width: 0;
}

/* ④ 现在横跨整行，宽屏时一行铺开四个读数更像仪表盘 */
@media (min-width: 1180px) {
  .pf-hosted .exp-wrap .exp-read { flex: 1 1 calc(25% - 11px); }
}

.pf-hosted .exp-wrap .exp-table-wrap { overflow-x: auto; }

.pf-hosted .exp-wrap .exp-tags { gap: 10px; }

/* ---------------------------------------------------------------------
 * 3. 实验名称只在页眉：① 区那个大标题删掉（外壳装配时已剥离，
 *    这里再做一层兜底，防止旧页面或手写页面漏网）
 * ------------------------------------------------------------------- */
.pf-hosted .exp-info .exp-name {
  display: none !important;
}

/* 名字挪走后，① 区首个元素不要留出额外的上间距 */
.pf-hosted .exp-info > *:first-child {
  margin-top: 0;
}
  </style>
</head>
<body>
  <header class="pf-header">
    <span class="pf-logo"><img src="logo.png" alt="平台标志"></span>
    <h1 class="pf-title"><span class="pf-fix">师伴-</span><span class="pf-page">溶解度曲线理解物质溶解度</span></h1>
  </header>

  <aside class="pf-side">
    <label for="pf-dl"><span class="ico">📥</span><span class="pf-tip">下载本案例</span></label>
    <label for="pf-gen"><span class="ico">✨</span><span class="pf-tip">生成新案例</span></label>
    <label for="pf-contact"><span class="ico">📧</span><span class="pf-tip">联系我们，获取更多案例</span></label>
  </aside>

  <main class="pf-main">
    <div class="pf-content">
      <div class="exp-wrap">

        <!-- ① 实验信息 -->
        <section class="exp-info" id="sec-info">

<div class="exp-tags"><span class="exp-tag">化学</span><span class="exp-tag">九年级</span><span class="exp-tag is-plain">课标核心</span></div>
<div class="exp-goals-title">学习目标</div>
<ul class="exp-goals">
<li>能根据溶解度曲线查出指定温度下硝酸钾、氯化钠的溶解度</li>
<li>能比较两条曲线陡缓差异，说明溶解度受温度影响大小</li>
<li>能依据曲线为含少量杂质的混合物选择蒸发结晶或降温结晶方案</li>
<li>能计算并预测降温或蒸发后析出晶体的质量</li>
</ul>
        </section>

        <div class="exp-grid">
          <!-- ② 演示画布 -->
          <section class="exp-card exp-stage" id="sec-stage">
            <h2>② 演示<span class="exp-hint" id="pf-stage-hint">拖动画面可旋转视角</span></h2>
            <div class="exp-canvas-box">
<canvas id="cv"></canvas>
<span class="exp-canvas-tip">拖动温度/溶质/溶剂滑块，曲线上的查询点实时移动</span>
            </div>
          </section>

          <!-- ③ 参数与操作 -->
          <section class="exp-card exp-control" id="sec-control">
            <h2>③ 参数与操作</h2>
<div class="exp-field">
  <div class="exp-label"><span>温度 T</span><span class="exp-val"><b id="v-t">60</b> ℃</span></div>
  <input type="range" id="rg-t" min="0" max="100" step="1" value="60" data-key="T">
</div>
<div class="exp-field">
  <div class="exp-label"><span>溶质质量 m</span><span class="exp-val"><b id="v-m">60</b> g</span></div>
  <input type="range" id="rg-m" min="10" max="100" step="1" value="60" data-key="m">
</div>
<div class="exp-field">
  <div class="exp-label"><span>溶剂质量 W</span><span class="exp-val"><b id="v-w">100</b> g</span></div>
  <input type="range" id="rg-w" min="50" max="200" step="5" value="100" data-key="W">
</div>
<div class="exp-btns">
  <button class="exp-btn" id="btn-evap" type="button">蒸发溶剂</button>
  <button class="exp-btn" id="btn-cool" type="button">降温结晶</button>
  <button class="exp-btn is-primary" id="btn-record" type="button">记录当前数据</button>
  <button class="exp-btn" id="btn-reset" type="button">重置</button>
</div>
          </section>

          <!-- ④ 结果与反馈 -->
          <section class="exp-card exp-result" id="sec-result">
            <h2>④ 结果与反馈</h2>
<div class="exp-reads">
  <div class="exp-read"><span class="k">KNO₃ 溶解度</span><span class="v"><b id="r-sk">0.0</b> <span class="u">g/100 g 水</span></span></div>
  <div class="exp-read"><span class="k">NaCl 溶解度</span><span class="v"><b id="r-sn">0.0</b> <span class="u">g/100 g 水</span></span></div>
  <div class="exp-read"><span class="k">析出晶体</span><span class="v"><b id="r-p">0.0</b> <span class="u">g</span></span></div>
</div>
<div class="exp-formula" id="fml"></div>
<p class="exp-note" id="hint"></p>
<div class="exp-alert" id="alert" hidden></div>
          </section>
        </div>

        <!-- ⑤ 实验记录 -->
        <section class="exp-card exp-record" id="sec-record">
          <h2>⑤ 实验记录<span class="exp-hint">点击「记录当前数据」逐行追加</span></h2>
          <div class="exp-table-wrap">
<table class="exp-table">
  <thead><tr><th>序号</th><th>温度(℃)</th><th>溶质/溶剂(g)</th><th>状态</th><th>析出量(g)</th></tr></thead>
  <tbody id="rows"></tbody>
</table>
          </div>
        </section>

        <!-- ⑥ 教学说明 -->
        <details class="exp-card exp-teach" id="sec-teach">
          <summary>⑥ 教学说明（原理 / 易错点 / 探究问题）</summary>
          <div class="exp-body">
<h3>原理</h3>
<ul>
<li>固体溶解度：一定温度下，100 g 溶剂（水）中达到饱和时所溶解溶质的质量，单位 g/100 g 水。</li>
<li>溶解度曲线越陡，溶解度受温度影响越大（KNO₃）；曲线平缓，影响小（NaCl）。</li>
<li>降温析出量 = (S高温 − S低温)/100 × 溶剂质量(g)；饱和溶液质量分数 = S/(100+S)×100%。</li>
<li>曲线上的点表示饱和，下方不饱和，上方有固体剩余；两曲线交点表示该温度下溶解度相等。</li>
</ul>
<h3>易错点</h3>
<ul>
<li>把溶解度说成「100 g 溶液中溶解的质量」，应为 100 g 溶剂。</li>
<li>忽略温度条件直接比较溶解度；把溶解度 S 直接当作溶质质量分数。</li>
<li>认为降温一定能析出晶体（对 Ca(OH)₂ 不成立，其溶解度随温度升高而减小）。</li>
<li>纵轴单位漏写「g/100 g 水」，误当百分比。</li>
</ul>
<h3>探究问题</h3>
<ol>
<li>60 ℃ 时 KNO₃ 与 NaCl 的溶解度各是多少？哪条曲线更陡？</li>
<li>把 60 ℃ 的 KNO₃ 饱和溶液降到 20 ℃，析出多少克？（用 100 g 水换算）</li>
<li>KNO₃ 中混有少量 NaCl，应选降温结晶还是蒸发结晶？为什么？</li>
</ol>
<h3>结论</h3>
<p>溶解度曲线定量反映温度对溶解能力的影响：KNO₃ 曲线陡，降温析出多，适合降温结晶提纯；NaCl 曲线平缓，降温析出少，适合蒸发结晶。析出量等于两温度下溶解度差按水量换算，且溶质质量守恒、析出量不为负。</p>
<h3>注意事项</h3>
<ul>
<li>本页为虚拟仿真，数据按教材常见值插值，不同版本教材略有差异，请以所用教材核对。</li>
<li>温度 0~100 ℃，溶解度不超过 250 g/100 g 水；水量 50~200 g。</li>
<li>溶质质量分数必须小于 100%，析出量不得为负；超出合理范围时页面给出警告。</li>
<li>计算析出量时须先读两个温度下的 S，再按水量换算，注意「g/100 g 水」的单位。</li>
</ul>
          </div>
        </details>

      </div>
    </div>
  </main>


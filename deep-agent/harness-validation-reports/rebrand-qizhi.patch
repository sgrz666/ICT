diff --git a/packages/client/ui-brand-qizhi/src/styles/qizhi-theme.css b/packages/client/ui-brand-qizhi/src/styles/qizhi-theme.css
new file mode 100644
index 0000000000..54be0244dd
--- /dev/null
+++ b/packages/client/ui-brand-qizhi/src/styles/qizhi-theme.css
@@ -0,0 +1,89 @@
+/*
+ * 启智AGENT glass layer, stylesheet half (v2).
+ *
+ * Surface fills, hairlines and accents are NOT here: they are alias-token
+ * overrides registered through `ctx.theme` (see `client/glass.ts`), which the
+ * theme presenter writes as inline variables on `body`. This file keeps only
+ * what a token cannot express — the fixed ambient backdrop and the compositing
+ * filter that makes a translucent panel read as frosted glass.
+ *
+ * Deliberate limits, all from docs/web-styling.md: modal backdrops stay
+ * unblurred (`--dsw-mask-blur: none`), menu material stays untouched
+ * (`--dsw-menu-surface-fill` / `--dsw-menu-backdrop-filter` are theme-owned and
+ * already glass), and no hand-made inset strokes — elevation hairlines come
+ * from `--dsw-elevation-stroke-color`, which follows `border-l4`.
+ *
+ * Blur is safe only where the element paints its own translucent fill: a
+ * `backdrop-filter` on a *transparent* layout wrapper smears everything behind
+ * it inside its box, which is how an early `[class*='_panel']` selector ate the
+ * right half of the page (the drawer has no fill of its own). The list is
+ * therefore short: the sidebar column alone, which paints
+ * `--dsw-specific-sidebar-fill` over the mesh. Semantic landmarks turned out to
+ * be traps — the left rail's panel list is a `<nav>` with no fill of its own,
+ * so `nav` reproduced the same smear at 36x84. CSS module names are hashed, so
+ * this anchors on the readable local-name suffix that css-modules preserves; a
+ * rename drops the frost, never the layout.
+ */
+
+/* ---- the canvas the panels refract ---- */
+
+:root {
+  --qizhi-glass-blur: 20px;
+  --qizhi-glass-saturate: 150%;
+}
+
+:root body {
+  background-color: #eef1f8;
+}
+
+:root body[data-ds-dark-theme] {
+  background-color: #080a12;
+}
+
+#root {
+  position: relative;
+  isolation: isolate;
+}
+
+#root::before {
+  content: '';
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  background:
+    radial-gradient(52rem 52rem at 12% -10%, rgba(124, 92, 255, 0.30), transparent 60%),
+    radial-gradient(46rem 46rem at 92% 6%, rgba(56, 225, 255, 0.24), transparent 62%),
+    radial-gradient(60rem 40rem at 50% 112%, rgba(78, 240, 176, 0.16), transparent 66%);
+}
+
+:root body:not([data-ds-dark-theme]) #root::before {
+  opacity: 0.45;
+}
+
+/* ---- the frost itself ---- */
+
+:where(aside, [class*='_sidebarCol']) {
+  -webkit-backdrop-filter: blur(var(--qizhi-glass-blur)) saturate(var(--qizhi-glass-saturate));
+  backdrop-filter: blur(var(--qizhi-glass-blur)) saturate(var(--qizhi-glass-saturate));
+}
+
+@media (max-width: 720px) {
+  :root {
+    --qizhi-glass-blur: 12px;
+  }
+}
+
+/* Reduced transparency: the mesh costs a full-screen paint and the blur costs
+ * compositing on every frame a surface moves. The token layer already went
+ * opaque for these users, so both decorative layers come off. */
+@media (prefers-reduced-transparency: reduce) {
+  #root::before {
+    display: none;
+  }
+
+  :where(aside, [class*='_sidebarCol']) {
+    backdrop-filter: none;
+    -webkit-backdrop-filter: none;
+  }
+}
diff --git a/packages/client/ui-brand-qizhi/tests/glass.spec.ts b/packages/client/ui-brand-qizhi/tests/glass.spec.ts
new file mode 100644
index 0000000000..0308e90c5d
--- /dev/null
+++ b/packages/client/ui-brand-qizhi/tests/glass.spec.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from 'vitest'
+import { buildGlassTokens } from '../src/client/glass.ts'
+
+/** Tokens that must stay readable because they paint over app content. */
+const OVER_CONTENT = ['--dsw-alias-bg-layer-1', '--dsw-alias-bg-layer-2', '--dsw-alias-bg-layer-3',
+  '--dsw-alias-bg-overlay', '--dsw-alias-bg-module-platform', '--dsw-specific-input-major']
+
+/** The two surfaces allowed to show the ambient mesh through them. */
+const ON_BACKDROP = ['--dsw-alias-bg-base', '--dsw-specific-sidebar-fill']
+
+const value = (glass: boolean, name: string, mode: 'light' | 'dark'): string =>
+  buildGlassTokens(glass)[name]?.[mode] ?? ''
+
+const alphaOf = (rgba: string): number => Number(/([\d.]+)\)$/.exec(rgba)?.[1] ?? Number.NaN)
+
+/**
+ * The theme service rejects a bare string per token, so completeness of the
+ * { light, dark } pair is this layer's contract: a missing mode would ship an
+ * illegible palette. The live browser can only prove the scheme it is in.
+ */
+describe('qizhi glass token layer', () => {
+  for (const glass of [true, false]) {
+    it(`every token carries both palettes (glass=${String(glass)})`, () => {
+      const tokens = buildGlassTokens(glass)
+      expect(Object.keys(tokens).length).toBeGreaterThan(10)
+      for (const [name, modes] of Object.entries(tokens)) {
+        expect(modes.light, name).toMatch(/^(#[0-9a-f]{3,8}|rgba?\(|color-mix\()/i)
+        expect(modes.dark, name).toMatch(/^(#[0-9a-f]{3,8}|rgba?\()/i)
+      }
+    })
+  }
+
+  it('moves only surfaces, hairlines and accents — never text tokens', () => {
+    for (const glass of [true, false]) {
+      for (const name of Object.keys(buildGlassTokens(glass))) {
+        expect(name, name).toMatch(/bg-|border-|brand-|link|interactive|sidebar-fill|input-major/)
+        expect(name, name).not.toMatch(/text-color|fg-|foreground/)
+      }
+    }
+  })
+
+  /**
+   * The regression this guards: a translucent panel over the transcript smears
+   * the text behind it, which is what broke the first cut of the glass page.
+   */
+  it('keeps surfaces that paint over app content near-opaque', () => {
+    for (const name of OVER_CONTENT) {
+      for (const mode of ['light', 'dark'] as const) {
+        const fill = value(true, name, mode)
+        expect(fill, `${name} ${mode}`).toMatch(/^rgba\(/)
+        expect(alphaOf(fill), `${name} ${mode}`).toBeGreaterThanOrEqual(0.94)
+      }
+    }

    "id": "preset-eduforge-dev",
    "name": "@deepseek-ai/dsh-agent-preset",
    "config": {
      "id": "eduforge-dev",
      "order": 2,
      "plugins": [
        {
          "id": "persona",
          "name": "@deepseek-ai/dsh-persona",
          "config": {
            "prefix": "你是启智AGENT开发助手，基于 {{model}} 模型。以可复核的文件、命令和测试完成用户任务。"

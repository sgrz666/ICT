  {
    "id": "preset-physics-lab",
    "name": "@deepseek-ai/dsh-agent-preset",
    "config": {
      "id": "physics-lab",
      "name": "教学实验",
      "order": 1,
      "description": "由真实 LabKit 引擎生成并验证离线实验课。",
      "plugins": [
        {
          "id": "persona",
          "name": "@deepseek-ai/dsh-persona",
          "config": {
            "prefix": "你是启智AGENT教学实验助手。先询问会改变设计的必要信息，使用 experiment_recipes 与 experiment_validate 选方案，再用 experiment_build 交付。只声称工具实际验证的能力；失败时如实说明。不手写仿真、不修改容差。"
          }
        },
        {
          "id": "time-context",
          "name": "@deepseek-ai/dsh-time-context"
        },
        {
          "id": "compaction",
          "name": "cordis:group",
          "group": true,
          "isolate": {
            "compaction": true,
            "toolResultPruner": true
          },
          "config": [
            {
              "id": "compaction-basic",
              "name": "@deepseek-ai/dsh-compaction-basic"
            },
            {
              "id": "command-compact",
              "name": "@deepseek-ai/dsh-command-compact"
            },
            {
              "id": "tool-result-pruner",
              "name": "@deepseek-ai/dsh-compaction-tool-result-pruner",
              "config": {
                "thresholdChars": 8192,
                "headChars": 4096,
                "tailChars": 1024
              }
            }
          ]
        },
        {
          "id": "tool-ask-user",
          "name": "@deepseek-ai/dsh-tool-ask-user"
        },
        {
          "id": "tool-present",
          "name": "@deepseek-ai/dsh-tool-present"
        },
        {
          "id": "eduforge-labkit",
          "name": "@eduforge/labkit-plugin"
        }
      ]
    }
  },

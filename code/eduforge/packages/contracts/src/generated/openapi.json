              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/revisions/{revision_id}/offline_verification": {
      "get": {
        "summary": "Revision Offline Verification",
        "description": "§C.5b 发布后重验：按清单逐文件重算磁盘字节。\n\n只看清单自身那份哈希是查不出篡改的——改一个 www/ 里的文件再重新生成一张\n自洽的清单，哈希照样对得上。这里逐文件比，并把发布前那份浏览器实测记录一并带回。\n代价是每次请求重算整包（当前模板约 2162 个文件），这是审计端点，不是热路径。",
        "operationId": "revision_offline_verification_api_v1_revisions__revision_id__offline_verification_get",
        "parameters": [
          {
            "name": "revision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Revision Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfflineVerification"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/artifacts/{artifact_id}/download": {
      "get": {
        "summary": "Download",
        "operationId": "download_api_v1_artifacts__artifact_id__download_get",
        "parameters": [
          {
            "name": "artifact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Artifact Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "交付的文件原文，不是业务 DTO；x-content-sha256 是这份字节的哈希，客户端必须先校验再用。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "headers": {
              "x-content-sha256": {
                "description": "响应字节的 SHA-256",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description": "Forbidden"

    "/api/v1/revisions/{revision_id}/views": {
      "get": {
        "summary": "Revision Views",
        "description": "§C.3 教学视图的出口：读发布时冻结在 `lesson` 里的那一份。\n\n界面不自己拼视图配置——教师勾了什么、记录表有哪些列与行，都以上线版本为准。\n归属照样顺着 experiments.owner_id 走一遍：知道 UUID 从来不是访问凭据。",
        "operationId": "revision_views_api_v1_revisions__revision_id__views_get",
        "parameters": [
          {
            "name": "revision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Revision Id"

    ],
    "generic_phrases": [
      "更有趣",
      "更直观",
      "效果好",
      "更生动",
      "更美观"
    ]
  },
  "render": {
    "canvas": {
      "width": 960,
      "height": 540
    },
    "grid_m": 5,
    "colors": [
      "#0f766e",

{
  "schema": "eduforge.labkit.recipes/v1",
  "template_id": "circuits.ohms_law",
  "title": "直流电路：欧姆定律与串并联",
  "engine": {
    "id": "circuit_mna",
    "version": "1.0",
    "solver": "modified_nodal_analysis",
    "cross_check": "CircuitJS1 2026-10-19 实测证据（source/library/circuit-lab-evidence.json）"
  },
  "recipes": [
    {
      "id": "ohms-law",
      "title": "欧姆定律：I = U / R",
      "intent": "同一电压下，电流与电阻成反比；I=U/R。",
      "intent_keywords": ["欧姆定律", "电流", "电压", "电阻", "反比"],
      "params_mode": "single",
      "scenarios": [
        { "id": "main", "params": { "voltage_v": 5, "resistance_ohm": 100 } }
      ],
      "metric_keys": ["I", "U"],
      "metrics": ["I", "U"],
      "tolerances_pct": { "I": 0.000001, "U": 0.000001 }
    },
    {
      "id": "series",
      "title": "串联：电流相同，电压按阻值分配",
      "intent": "串联电路电流处处相同，U1:U2=R1:R2，总电阻 R=R1+R2。",
      "intent_keywords": ["串联", "电流", "电压", "分压", "电阻"],
      "params_mode": "single",
      "scenarios": [
        { "id": "main", "params": { "voltage_v": 5, "resistance_ohm": 100, "r2_ohm": 220 } }
      ],
      "metric_keys": ["I", "U1", "U2"],
      "metrics": ["I", "U1", "U2"],
      "tolerances_pct": { "I": 0.000001, "U1": 0.000001, "U2": 0.000001 }
    },
    {
      "id": "parallel",
      "title": "并联：电压相同，电流按电阻分配",
      "intent": "并联电路各支路电压相同，I1:I2=R2:R1，等效电阻 1/R=1/R1+1/R2。",
      "intent_keywords": ["并联", "电流", "电压", "分流", "等效电阻"],
      "params_mode": "single",
      "scenarios": [
        { "id": "main", "params": { "voltage_v": 5, "resistance_ohm": 100, "r2_ohm": 220 } }
      ],
      "metric_keys": ["I1", "I2", "I", "Req"],
      "metrics": ["I1", "I2", "I", "Req"],
      "tolerances_pct": { "I1": 0.000001, "I2": 0.000001, "I": 0.000001, "Req": 0.000001 }
    }
  ],
  "acceptance": {
    "formulas_display": {
      "ohm": "I = U / R",
      "series": "I = U/(R1+R2)，U1=I·R1，U2=I·R2",
      "parallel": "I1=U/R1，I2=U/R2，Req=R1·R2/(R1+R2)"
    },
    "note": "MNA 与解析式在双精度下应逐位一致（容差 1e-6 用于显示/传输舍入）；CircuitJS1 的实测值作为外部交叉验证。"
  },
  "decision": {
    "voltage_range": [1, 12],
    "resistance_range": [10, 1000],
    "max_current_a": 2,
    "max_power_w": 5
  },
  "reason": {
    "variables": ["电流", "电压", "电阻", "等效电阻", "分压", "分流"],

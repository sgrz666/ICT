    "task_metrics": ["电流", "电压", "电阻", "等效电阻", "读数", "比值"],
    "generic_phrases": ["更有趣", "更直观", "效果好", "更生动", "更美观"]
  },
  "render": {
    "canvas": { "width": 960, "height": 540 },
